{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/lightide-plugin-manifest-v1.json",
  "title": "LightIDE Markdown Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pluginId",
    "version",
    "displayName",
    "apiVersion",
    "activation",
    "permissions",
    "contributions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,119}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "publisher": {
      "type": "string",
      "maxLength": 120
    },
    "activation": {
      "type": "string",
      "enum": [
        "onCommand",
        "onMarkdownOpen",
        "manual"
      ]
    },
    "entryPoint": {
      "type": "string",
      "maxLength": 260
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "document.read.selection",
          "document.read.active",
          "document.write.active",
          "file.read.workspace",
          "file.write.workspace",
          "network.access",
          "process.spawn"
        ]
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "tools"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "insert",
                  "transform",
                  "panel",
                  "validator",
                  "renderer",
                  "command"
                ]
              },
              "when": {
                "type": "string"
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "commandId",
              "groupId",
              "icon"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "commandId": {
                "type": "string"
              },
              "groupId": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "maxLength": 80
              },
              "rank": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          }
        },
        "menus": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "renderers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
