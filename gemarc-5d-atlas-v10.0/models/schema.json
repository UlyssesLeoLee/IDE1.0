{
  "schema": "ide1-5d-atlas/engineering-model/v10.0",
  "description": "Canonical engineering model — 记录类型、字段、枚举、图能力要求与查询 API。本文件是数据契约，同时被 src/validate.js 的轻量校验器消费（不依赖 ajv，file:// 可用）。",
  "enumerations": {
    "existence_0d": [
      "Present",
      "Absent",
      "Unknown"
    ],
    "implementation": [
      "Implemented",
      "Designed",
      "Inferred",
      "Absent",
      "Unknown"
    ],
    "evidence_kind": [
      "SourceCode",
      "TestTrace",
      "RuntimeLog",
      "Document",
      "PublicObservation",
      "UserRequirement"
    ],
    "scenario_origin": [
      "ObservedReplay",
      "DesignedSimulation",
      "HypotheticalExperiment"
    ],
    "gap_type": [
      "GAP_SOURCE_DOCUMENT",
      "GAP_BUSINESS_DECISION",
      "ATLAS_FAIL",
      "NOT_APPLICABLE"
    ],
    "qa_status": [
      "PASS",
      "FAIL",
      "NOT_TESTED",
      "DEGRADED",
      "BLOCKED",
      "FLAKY_UNRESOLVED"
    ]
  },
  "implementation_gate": {
    "rule": "Implemented 必须有目标工程中落实相应行为的代码 path:startLine-endLine 和 revision",
    "insufficient_evidence": [
      "依赖声明",
      "目录结构",
      "接口定义",
      "DTO",
      "Mock",
      "TODO",
      "注释",
      "文档描述"
    ],
    "no_source_rule": "仅公开网站不能证明私有后端事实；没有源码不能把 Unknown 判成 Absent",
    "observed_note": "Observed 属于证据类型（evidence_kind / scenario_origin），不混用为实现状态"
  },
  "records": {
