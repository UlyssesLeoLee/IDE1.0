      "required": [
        "id",
        "repo",
        "branch",
        "sha",
        "capturedAt"
      ],
      "optional": [
        "remote",
        "dirty",
        "note"
      ],
      "types": {
        "id": "string",
        "repo": "string",
        "branch": "string",
        "sha": "string",
        "capturedAt": "string",
        "remote": "string?",
        "dirty": "boolean?",
        "note": "string?"
