{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "ide1-5d-atlas/tokens/v10.0",
  "meta": {
    "identity": "Quiet Precision",
    "rationale": "低饱和背景 + 高辨识度但克制的状态色；业务域色不复用为错误色；不可只靠红绿表达。",
    "source": "v10.0 html_design_system.base_tokens + sizing/typography/component/motion tokens + spatial_visual_standard.domain_palette",
    "note": "所有数值为规范基线默认值。组件不得局部覆盖；任何调整必须回写本文件。"
  },
  "color": {
    "base": {
      "background": "#0B1220",
      "surface": "#121D2E",
      "raised": "#1C2A3D",
      "primary_text": "#E8EFF7",
      "secondary_text": "#AAB9CB",
      "focus": "#5AC7C3",
      "information": "#82ADFA",
      "success": "#74CA9D",
      "warning": "#F0BA63",
      "failure": "#F08886",
      "muted_edge": "#40536A"
    },
    "domain": {
      "Core": "#4C83FF",
      "Interaction": "#19AFA3",
      "Data": "#32B67A",
      "Security": "#E8B34F",
      "Intelligence": "#A276E8",
      "Infrastructure": "#8397B7",
      "External": "#38A6D6",
      "Operations": "#D87792",
      "Unknown": "#81909F"
    }
  },
  "spacing": {
    "base": 4,
    "scale": [4, 8, 12, 16, 24, 32],
    "rule": "4px 基准；禁临时不一致的内边距"
  },
  "sizing": {
    "header_height": "60px",
    "left_sidebar": "256px",
    "right_inspector": "360px",
    "min_canvas_width": "480px",
    "timeline_height": "136px",
    "control_height": "36px"
  },
  "typography": {
    "caption": { "fontSize": "12px", "lineHeight": "18px" },
    "small": { "fontSize": "13px", "lineHeight": "20px" },
    "body": { "fontSize": "14px", "lineHeight": "22px" },
    "subtitle": { "fontSize": "16px", "lineHeight": "24px" },
    "heading": { "fontSize": "20px", "lineHeight": "28px" },
    "title": { "fontSize": "28px", "lineHeight": "36px" },
    "numeric": { "fontVariantNumeric": "tabular-nums" },
    "levels": ["title", "heading", "subtitle", "body", "caption"],
    "code": "独立等宽层级",
    "cjkFallback": "Noto Sans SC / PingFang SC / Hiragino Sans GB / Microsoft YaHei"
  },
  "component": {
    "radius_sm": "6px",
    "radius_md": "10px",
    "radius_lg": "14px",
    "stroke": "1px",
    "focus_ring": "2px"
  },
  "motion": {
    "micro": "140ms",
    "standard": "220ms",
    "spatial": "320ms",
    "easing": "ease-out",
    "reduced_motion": "0ms or minimal fade"
  },
  "ring": {
    "states": ["Idle", "Running", "Waiting", "Completed", "Failed", "Recovered", "Blocked", "Authorized", "Rejected", "Unknown"],
    "source": "实际使用的 9 个状态 = models/causal-rules.json 全部 stateMachines 的 states 并集：Idle / Running / Waiting / Completed / Failed / Recovered / Blocked / Authorized / Rejected（Unknown 不在其中）",
    "stateNotes": {
      "Blocked": "琥珀 #F0BA63 阻断环",
      "Authorized": "success #74CA9D 认证通过环（鉴权专用环）",
      "Rejected": "failure #F08886 认证拒绝环（鉴权专用环）",
      "Unknown": "保留态：当前状态机未使用"
    }
  },
  "responsive": {
    "targets": ["390x844", "768x1024", "1024x700", "1440x900", "1920x1080"],
    "narrow": "390/768px 下侧栏和检查器改抽屉/底部面板；因果解释及原型 Tab 不能消失"
  },
  "accessibility": {
    "standard": "WCAG 2.2 AA 适用条款",
    "requirements": [
      "键盘可达",
      "可见焦点环",
      "对比度达标",
      "语义控件",
      "Reduced Motion",
      "200% 缩放可用",
      "图形功能不能只能鼠标操作"
    ],
    "notColorOnly": "不可只靠红绿表达状态；失败态须形状+文字+图标组合"
  },
  "heuristics": [
    "默认仅显示关键标签",
    "不隐藏可点击 Node/Edge",
    "选中对象保持上下文",
    "不让浮窗覆盖关键操作",
    "错误和空状态明确",
    "图例不显示 null/undefined"
  ]
}
