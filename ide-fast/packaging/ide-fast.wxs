<?xml version="1.0" encoding="UTF-8"?>
<!-- IDE1.0 安装包 (WiX v3)。构建: packaging/build-msi.ps1 (它会先用 cargo 构建 release 版)。 -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="IDE1.0" Language="1033" Version="$(var.Version)" Manufacturer="ide1" UpgradeCode="eeec6d8b-4609-4df9-999b-ddadc720c74e">
    <Package InstallerVersion="450" Compressed="yes" InstallScope="perMachine" Description="IDE1.0 - High-Performance Text and Code Editor" SummaryCodepage="1252" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of IDE1.0 is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ProductIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <!-- 彻底移除 WixUI_InstallDir 与任何 Windows 原生对话框，杜绝原生标题栏与 Back/Next/Cancel 按钮 -->
    <!-- 安装开始前安全终止可能残留或被占用的 IDE1.0 实例 -->
    <CustomAction Id="KillRunningIDE" Directory="TARGETDIR" ExeCommand="[SystemFolder]taskkill.exe /F /IM IDE1.0.exe /IM ide-fast.exe /FI &quot;STATUS eq RUNNING&quot;" Return="ignore" />
    <!-- 安装/升级/修复完成自动拉起 IDE1.0 主程序（卸载或自动化传 IDE10_NO_LAUNCH=1 时跳过） -->
    <CustomAction Id="LaunchIDE" FileKey="IdeFastExe" ExeCommand="" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="KillRunningIDE" Before="InstallValidate" />
      <Custom Action="LaunchIDE" After="InstallFinalize">NOT REMOVE="ALL" AND NOT IDE10_NO_LAUNCH</Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="IDE1.0">
          <Directory Id="LOGSFOLDER" Name="logs" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExe" Guid="*">
        <File Id="IdeFastExe" Source="$(var.ExePath)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- 安装路径下的 logs 日志目录组件: 允许所有本地用户向 logs 写入性能与崩溃日志 -->
    <DirectoryRef Id="LOGSFOLDER">
      <Component Id="LogsFolderComponent" Guid="d8a4f07e-9762-4b21-9e8c-1f5e27a69b12">
        <CreateFolder>
          <Permission User="Everyone" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <!-- 开始菜单快捷方式: 单独一个组件, 以 HKCU 注册表项作 KeyPath (Windows Installer 对快捷方式的要求); 目标写成 [INSTALLFOLDER]IDE1.0.exe 而不是 [#文件Id], 否则快捷方式与目标文件分属两个组件会触发 ICE69 -->
    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="IdeFastShortcut" Name="IDE1.0" Target="[INSTALLFOLDER]IDE1.0.exe" WorkingDirectory="INSTALLFOLDER" Icon="ProductIcon" Description="IDE1.0 - High-Performance Text and Code Editor" />
        <RegistryValue Root="HKCU" Key="Software\ide1\IDE1.0" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- 桌面快捷方式 -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="IdeFastDesktopShortcut" Name="IDE1.0" Target="[INSTALLFOLDER]IDE1.0.exe" WorkingDirectory="INSTALLFOLDER" Icon="ProductIcon" Description="IDE1.0 - High-Performance Text and Code Editor" />
        <RegistryValue Root="HKCU" Key="Software\ide1\IDE1.0" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="IDE1.0" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="LogsFolderComponent" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
