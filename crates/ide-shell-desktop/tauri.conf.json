{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDE1.0 IDE Shell",
  "version": "0.1.6",
  "identifier": "dev.ide1.0.shell",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "IDE1.0 IDE Shell",
        "width": 960,
        "height": 600,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "IDE1.0 IDE Shell — TUI + AI + Vim + 鼠标 (ULYS-191 §3)",
    "longDescription": "IDE1.0 IDE Shell 桌面应用 — 复用 Rust ide-shell core, 提供 Vim normal/insert/command 三态、鼠标交互、AI bridge (placeholder) 和 .aci.json schema 集成."
  }
}
