{
  "id": "theme-crystal",
  "name": "水晶透明主题",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.1.2",
  "license": "MIT",
  "description": "高透光水晶切面与动态字符级反色主题 (像钻石与水晶般的折射棱纹，字形级动态反色)",
  "repo": "UlyssesLeoLee/IDE1.0",
  "entry": "main.js",
  "permissions": [],
  "contributes": {
    "theme": {
      "id": "crystal",
      "name": "水晶透明",
      "label": "水晶透明",
      "translucent": true,
      "vars": {
        "--bg-bar": "rgba(255, 255, 255, 0.08)",
        "--bg-side": "rgba(255, 255, 255, 0.06)",
        "--bg-edit": "transparent",
        "--bg-rail": "rgba(255, 255, 255, 0.08)",
        "--bg-bottom": "rgba(255, 255, 255, 0.09)",
        "--bg-status": "rgba(255, 255, 255, 0.12)",
        "--bg-chrome": "rgba(255, 255, 255, 0.07)",
        "--bg-raised": "rgba(255, 255, 255, 0.12)",
        "--bg-hover": "rgba(255, 255, 255, 0.22)",
        "--bg-active": "rgba(255, 255, 255, 0.35)",
        "--bg-input": "rgba(255, 255, 255, 0.15)",
        "--border": "rgba(255, 255, 255, 0.45)",
        "--border-strong": "rgba(255, 255, 255, 0.70)",
        "--fg": "#ffffff",
        "--fg-muted": "rgba(255, 255, 255, 0.88)",
        "--fg-dim": "rgba(255, 255, 255, 0.68)",
        "--fg-on-accent": "#ffffff",
        "--blue": "#00f0ff",
        "--green": "#7ee2b8",
        "--yellow": "#ffd700",
        "--red": "#ff69b4",
        "--orange": "#ffaa44",
        "--accent-text": "#00f0ff",
        "--mat-prism-cyan": "#00f0ff",
        "--mat-prism-pink": "#ff69b4",
        "--focus-ring": "0 0 0 1px rgba(255,255,255,0.7), 0 0 8px rgba(0,240,255,0.6)",
        "--pill-mix": "68%",
        "luminance": "dynamic"
      }
    }
  }
}
