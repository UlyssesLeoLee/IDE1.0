{
  "id": "theme-crystal",
  "name": "透明水晶主题",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.1.2",
  "license": "MIT",
  "description": "次世代透明水晶界面：融合亚克力防眩光底衬与高透棱镜色散切面，字符级动态反色与高折射光学质感",
  "repo": "UlyssesLeoLee/IDE1.0",
  "entry": "main.js",
  "permissions": [],
  "contributes": {
    "theme": {
      "id": "crystal",
      "name": "透明水晶",
      "label": "透明水晶",
      "translucent": true,
      "vars": {
        "--bg-bar": "rgba(10, 16, 26, 0.16)",
        "--bg-side": "rgba(8, 12, 20, 0.13)",
        "--bg-edit": "transparent",
        "--bg-rail": "rgba(10, 16, 26, 0.14)",
        "--bg-bottom": "rgba(10, 16, 26, 0.16)",
        "--bg-status": "rgba(12, 18, 30, 0.18)",
        "--bg-chrome": "rgba(10, 16, 26, 0.12)",
        "--bg-raised": "rgba(255, 255, 255, 0.08)",
        "--bg-hover": "rgba(255, 255, 255, 0.18)",
        "--bg-active": "rgba(255, 255, 255, 0.28)",
        "--bg-input": "rgba(10, 16, 26, 0.24)",
        "--border": "rgba(255, 255, 255, 0.48)",
        "--border-strong": "rgba(255, 255, 255, 0.75)",
        "--fg": "#ffffff",
        "--fg-muted": "rgba(255, 255, 255, 0.90)",
        "--fg-dim": "rgba(255, 255, 255, 0.70)",
        "--fg-on-accent": "#ffffff",
        "--blue": "#00f0ff",
        "--green": "#7ee2b8",
        "--yellow": "#ffd700",
        "--red": "#ff69b4",
        "--orange": "#ffaa44",
        "--accent-text": "#00f0ff",
        "--mat-prism-cyan": "#00f0ff",
        "--mat-prism-pink": "#ff69b4",
        "--focus-ring": "0 0 0 1px rgba(255,255,255,0.7), 0 0 8px rgba(0,240,255,0.6)",
        "--pill-mix": "68%",
        "luminance": "dynamic"
      }
    }
  }
}
