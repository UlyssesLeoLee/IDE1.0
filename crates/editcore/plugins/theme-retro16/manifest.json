        "--bg-input": "#150f2b",
        "--border": "#2d2354",
        "--border-strong": "#4f3e91",
        "--fg": "#f0f4fc",
        "--fg-muted": "#7882a4",
        "--fg-dim": "#4e5675",
        "--fg-on-accent": "#ffffff",
        "--blue": "#00f0ff",
