{
  "id": "theme-retro16",
  "name": "复古 16-Bit 主题",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.1.2",
  "license": "MIT",
  "description": "街机暗夜深紫底色 + 16 位荧光色 + 阶梯像素边框",
  "repo": "UlyssesLeoLee/IDE1.0",
  "entry": "main.js",
  "permissions": [],
  "contributes": {
    "theme": {
      "id": "retro16",
