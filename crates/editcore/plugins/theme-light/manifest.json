{
  "id": "theme-light",
  "name": "浅色主题",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.1.2",
  "license": "MIT",
  "description": "明亮纯白工作台浅色主题，精密灰阶分层与高对比可读性",
  "repo": "UlyssesLeoLee/IDE1.0",
  "entry": "main.js",
  "permissions": [],
  "contributes": {
    "theme": {
      "id": "light",
      "name": "浅色",
      "label": "浅色",
      "translucent": false,
      "vars": {
        "--bg-bar": "#f8f8f8",
        "--bg-side": "#ffffff",
        "--bg-edit": "#ffffff",
        "--bg-rail": "#f0f0f0",
        "--bg-bottom": "#f8f8f8",
        "--bg-status": "#005fb8",
        "--bg-chrome": "#f2f2f2",
        "--bg-raised": "#ffffff",
        "--bg-hover": "rgba(0,0,0,0.04)",
        "--bg-active": "rgba(0,0,0,0.08)",
        "--bg-input": "#ffffff",
        "--border": "#e5e5e5",
        "--border-strong": "#cccccc",
        "--fg": "#1f1f1f",
        "--fg-muted": "#5f5f5f",
        "--fg-dim": "#8a8a8a",
        "--fg-on-accent": "#ffffff",
        "--blue": "#005fb8",
        "--green": "#0f7b41",
        "--yellow": "#7d6608",
        "--red": "#c72e0f",
        "--orange": "#b35900",
        "--focus-ring": "0 0 0 1px #ffffff, 0 0 0 3px #005fb8",
        "--pill-mix": "62%",
        "--accent-text": "#005fb8"
      }
    }
  }
}
